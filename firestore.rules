rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return isSignedIn() && userProfile().active == true;
    }

    function myRole() {
      return userProfile().role;
    }

    function isAdmin() {
      return isActive() && myRole() == 'ADMIN';
    }

    function isStaff() {
      return isActive() && myRole() in ['ADMIN', 'DOCENTE', 'ALUNO'];
    }

    /* ---------------- USERS ---------------- */
    match /users/{userId} {
      // Emails e papéis só são visíveis ao próprio usuário ou à administração.
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);

      // Auto-cadastro: o próprio usuário só pode criar o PRÓPRIO documento,
      // e sempre com papel VISITANTE (evita se auto-promover a ADMIN).
      allow create: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId
            && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'active', 'createdAt'])
            && request.resource.data.name is string
            && request.resource.data.email is string
            && request.resource.data.role == 'VISITANTE'
            && request.resource.data.active == true);

      // Um usuário pode atualizar o próprio perfil, mas NUNCA o próprio papel
      // ou status de ativo/inativo — só um ADMIN pode fazer isso.
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
            && request.resource.data.name is string);

      allow delete: if isAdmin();
    }

    /* ---------------- COMPONENT TYPES (+ atributos + opções embutidos) ---------------- */
    match /componentTypes/{typeId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin();
    }

    /* ---------------- COMPONENTS ---------------- */
    match /components/{componentId} {
      allow read: if isActive();
      allow create, update, delete: if isStaff();
    }

    /* ---------------- STOCK MOVEMENTS (trilha de auditoria imutável) ---------------- */
    match /stockMovements/{movementId} {
      allow read: if isActive();
      allow create: if isStaff() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    /* ---------------- TOOLS ---------------- */
    match /tools/{toolId} {
      allow read: if isActive();
      allow create, delete: if isStaff();
      // Um equipamento emprestado só pode ser alterado pelo responsável pelo
      // empréstimo ou por um administrador (inclusive para a devolução).
      allow update: if isAdmin()
        || (isStaff()
            && (resource.data.status != 'EMPRESTADA'
                || resource.data.currentLoan.userId == request.auth.uid));
    }

    /* ---------------- TOOL LOANS ---------------- */
    match /toolLoans/{loanId} {
      allow read: if isActive();

      allow create: if isStaff()
          && request.resource.data.userId == request.auth.uid;

      allow update: if isAdmin()
        || (isStaff() && resource.data.userId == request.auth.uid);

      allow delete: if isAdmin();
    }

    /* ---------------- MICROCONTROLLERS ---------------- */
    match /microcontrollers/{microcontrollerId} {
      allow read: if isActive();
      allow create, delete: if isStaff();
      // Uma placa emprestada só pode ser alterada pelo responsável pelo
      // empréstimo ou por um administrador (inclusive para a devolução).
      allow update: if isAdmin()
        || (isStaff()
            && (resource.data.status != 'EMPRESTADA'
                || resource.data.currentLoan.userId == request.auth.uid));
    }

    /* ---------------- MICROCONTROLLER LOANS ---------------- */
    match /microcontrollerLoans/{loanId} {
      allow read: if isActive();

      allow create: if isStaff()
          && request.resource.data.userId == request.auth.uid;

      allow update: if isAdmin()
        || (isStaff() && resource.data.userId == request.auth.uid);

      allow delete: if isAdmin();
    }

    /* ---------------- COMPONENT LOANS ---------------- */
    match /componentLoans/{loanId} {
      allow read: if isActive();

      allow create: if isStaff()
          && request.resource.data.userId == request.auth.uid;

      allow update: if isAdmin()
        || (isStaff() && resource.data.userId == request.auth.uid);

      allow delete: if isAdmin();
    }

    /* ---------------- COMPONENT KITS ---------------- */
    match /componentKits/{kitId} {
      allow read: if isActive();
      allow create, update, delete: if isStaff();
    }
  }
}
